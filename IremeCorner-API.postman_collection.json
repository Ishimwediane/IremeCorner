{
  "info": {
    "name": "IremeCorner API",
    "description": "Complete API collection for IremeCorner - Handmade Crafts & Training Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "artisanToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "buyerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "http://localhost:5000/health"
      }
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"buyer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{buyerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Get Featured Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/featured",
              "host": ["{{baseUrl}}"],
              "path": ["products", "featured"]
            }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{artisanToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Handmade Silver Ring\",\n  \"description\": \"Beautiful handmade silver ring with intricate design\",\n  \"price\": 89.99,\n  \"stock\": 10,\n  \"categoryId\": \"category-uuid\",\n  \"material\": \"Silver\",\n  \"dimensions\": \"Size 7\",\n  \"color\": \"Silver\",\n  \"style\": \"Vintage\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Get All Courses",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/courses",
              "host": ["{{baseUrl}}"],
              "path": ["courses"]
            }
          }
        },
        {
          "name": "Get Featured Courses",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/courses/featured",
              "host": ["{{baseUrl}}"],
              "path": ["courses", "featured"]
            }
          }
        },
        {
          "name": "Create Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{artisanToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Introduction to Jewelry Making\",\n  \"description\": \"Learn the basics of jewelry making with this comprehensive course\",\n  \"shortDescription\": \"Basic jewelry making techniques\",\n  \"price\": 149.99,\n  \"categoryId\": \"course-category-uuid\",\n  \"level\": \"beginner\",\n  \"duration\": 120,\n  \"lessons\": 8,\n  \"requirements\": [\"Basic tools\", \"Patience\"],\n  \"learningOutcomes\": [\"Create simple jewelry\", \"Understand materials\", \"Master basic techniques\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/courses",
              "host": ["{{baseUrl}}"],
              "path": ["courses"]
            }
          }
        },
        {
          "name": "Enroll in Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses/:courseId/enroll",
              "host": ["{{baseUrl}}"],
              "path": ["courses", ":courseId", "enroll"],
              "variable": [
                {
                  "key": "courseId",
                  "value": "course-uuid"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{buyerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"product-uuid\",\n      \"quantity\": 2\n    }\n  ],\n  \"shippingAddress\": \"123 Main St, City, State, 12345\",\n  \"billingAddress\": \"123 Main St, City, State, 12345\",\n  \"notes\": \"Please handle with care\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{buyerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/my-orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "my-orders"]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Initiate Order Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{buyerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/order/:orderId",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "order", ":orderId"],
              "variable": [
                {
                  "key": "orderId",
                  "value": "order-uuid"
                }
              ]
            }
          }
        },
        {
          "name": "Initiate Course Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/course/:courseId",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "course", ":courseId"],
              "variable": [
                {
                  "key": "courseId",
                  "value": "course-uuid"
                }
              ]
            }
          }
        },
        {
          "name": "Get Payment History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{buyerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/history",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "history"]
            }
          }
        }
      ]
    },
    {
      "name": "File Uploads",
      "item": [
        {
          "name": "Upload Course Thumbnail",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{artisanToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "courseThumbnail",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "title",
                  "value": "My Course",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Course description",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/courses",
              "host": ["{{baseUrl}}"],
              "path": ["courses"]
            }
          }
        },
        {
          "name": "Upload Course Images",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{artisanToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "courseImages",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/courses/:courseId/images",
              "host": ["{{baseUrl}}"],
              "path": ["courses", ":courseId", "images"],
              "variable": [
                {
                  "key": "courseId",
                  "value": "course-uuid"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Get Payment Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/statistics",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "statistics"]
            }
          }
        },
        {
          "name": "Get Course Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses/statistics",
              "host": ["{{baseUrl}}"],
              "path": ["courses", "statistics"]
            }
          }
        }
      ]
    }
  ]
}






